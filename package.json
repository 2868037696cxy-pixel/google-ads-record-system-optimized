{
  "name": "ads-workbench",
  "version": "1.2.0",
  "description": "广告账号管理工作台 - 资源库 / 快速创建 / AdsPower 批量导出",
  "type": "commonjs",
  "scripts": {
    "start": "node server.js",
    "desktop": "electron .",
    "test": "node --test --test-concurrency=1 tests/*.test.js",
    "build:win": "electron-builder --win --x64 --publish never",
    "build:dir": "electron-builder --win --x64 --dir --publish never",
    "test:desktop": "node scripts/desktop-smoke.cjs",
    "test:desktop:remote": "node scripts/remote-smoke.cjs",
    "test:round73": "node scripts/round73-ui.cjs",
    "backup:check": "node scripts/backup.cjs verify"
  },
  "engines": {
    "node": ">=22.16.0"
  },
  "dependencies": {
    "fastify": "^5.2.0",
    "pdfjs-dist": "^6.4.299"
  },
  "devDependencies": {
    "electron": "44.7.0",
    "electron-builder": "26.15.3",
    "playwright": "1.64.0"
  },
  "main": "desktop/main.js",
  "productName": "账号工作台",
  "build": {
    "appId": "com.adsworkbench.desktop",
    "productName": "AdsWorkbench",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "desktop/**",
      "lib/**",
      "public/**",
      "server.js",
      "package.json",
      "build/icon.ico"
    ],
    "asar": true,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "signAndEditExecutable": false,
      "artifactName": "AdsWorkbench-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "deleteAppDataOnUninstall": false,
      "createDesktopShortcut": true,
      "shortcutName": "账号工作台"
    },
    "toolsets": {
      "wine": "1.0.1"
    }
  }
}
